{
  "name": "multidaylpbot",
  "version": "0.1.0",
  "description": "Autonomous Meteora DLMM SOL/USDC LP manager driven by Claude Sonnet, with Telegram control plane.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:web": "cd web && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "cd web && npm run typecheck",
    "status": "tsx src/cli/status.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "decide": "tsx src/cli/decide.ts",
    "pnl": "tsx src/cli/pnl.ts",
    "dev": "tsx watch src/index.ts",
    "dev:web": "cd web && npm run dev",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@fastify/static": "^9.1.3",
    "@google/genai": "^2.0.1",
    "@meteora-ag/dlmm": "^1.9.10",
    "@solana/web3.js": "^1.98.4",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.9.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "groq-sdk": "^1.1.2",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "technicalindicators": "^3.1.0",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
