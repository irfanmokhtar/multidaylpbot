# Solana
RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=                # base58-encoded secret key (e.g. exported from Jupiter Wallet)

# Meteora DLMM pool address to manage.
# Find at https://app.meteora.ag — open your pool, copy the pair address.
POOL_ADDRESS=

# Operating mode
MODE=dryrun                        # dryrun | live
LOG_LEVEL=info                     # debug | info | warn | error

# Telegram (required to start the bot via `npm run dev`)
#  1. Talk to @BotFather → /newbot → copy token into TELEGRAM_BOT_TOKEN
#  2. Send any message to your new bot, then visit
#     https://api.telegram.org/bot<TOKEN>/getUpdates and copy the "chat":{"id":...}
#     value — that's your TELEGRAM_CHAT_ID. The bot will only respond to messages from
#     this chat; everyone else is silently ignored.
TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_CHAT_ID=                # numeric chat id — see comment above

# LLM provider for the TA analyzer. Pick one and set the matching key below.
#   gemini     — Gemini 2.5 Flash (default; free tier: 1,500 RPD)
#   groq       — Llama 3.3 70B (free tier: 1,000 RPD, fastest inference)
#   anthropic  — Claude Sonnet 4.5 (paid; ~$3-5/month at this bot's volume)
LLM_PROVIDER=gemini
LLM_MODEL=                       # optional; overrides the provider's default model

# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Get an Anthropic key at https://console.anthropic.com/ (paid)
ANTHROPIC_API_KEY=

# Birdeye OHLCV fetcher (sign up free at https://birdeye.so/developers).
# Free "Standard" tier: 1 RPS, limited to 3 endpoints + per-key CU budget. The
# bot self-throttles to ≥1.1s between requests and retries once on 429 honoring
# Retry-After. To multiply effective CU budget, register multiple free keys and
# put them in BIRDEYE_API_KEYS (comma-separated). Client auto-rotates on
# CU/quota errors and 429s. BIRDEYE_API_KEYS takes precedence over BIRDEYE_API_KEY.
BIRDEYE_API_KEY=
BIRDEYE_API_KEYS=

# Safety knobs (Phase 5+)
MAX_DEPLOY_USD=1000
COUNTDOWN_SEC=60
REBALANCE_SLIPPAGE_PCT=1.0          # Phase 5 — slippage tolerance on rebalance tx
WIDTH_CHANGE_TOLERANCE_BINS=10       # within band → re-center; outside → close+reopen
MAX_BIN_SLIPPAGE=15                  # base bin-count tolerance for active-bin drift on rebalance; retries escalate ×2, ×3 (cap 50). SDK default 3
REBALANCE_MAX_RETRIES=2              # balanced-path retries on ExceededBinSlippageTolerance (6004); each retry backs off 750ms, re-simulates, widens slippage

# Jupiter Ultra swap layer (Phase 9). When close+reopen runs, the bot derives a
# target X:Y ratio for the new range and swaps via Jupiter Ultra to match it
# before reopening. Set SWAP_ENABLED=false to skip swaps (deposit whatever the
# wallet holds, legacy behavior). JUPITER_API_KEY is optional (free tier works).
SWAP_ENABLED=true
JUPITER_API_KEY=
SWAP_SLIPPAGE_BPS=100                # 1% slippage tolerance on Jupiter swaps
SWAP_MIN_USD=1                       # skip swap when delta below this USD value
COMPOSITION_SHIFT_THRESHOLD_PCT=10   # |targetXWeight − currentXWeight| (pp) → force close+reopen

# Read-only dashboard (Phase 8). Bound to 127.0.0.1 only.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3001

# Scheduler (Phase 4.5 — dry-run only; no on-chain execution yet)
SCHEDULER_ENABLED=true
CRON_DAILY=0 8,20 * * *            # full TA + Telegram report 8AM and 8PM (always notifies)
CRON_INTRADAY=0 0,4,12,16 * * *    # light TA every 4h except 08:00 (daily-ta) and 20:00 (near 21:00 daily-ta); notifies only if action != hold
CRON_HEALTH=0 * * * *              # hourly position-health check (alerts only if out of range)
CRON_TZ=Asia/Kuala_Lumpur          # empty = system local time, e.g. "Asia/Kuala_Lumpur"

# 0 = analyzer's per-cycle default (4096 daily/ad_hoc, 2048 intraday).
# Bump if you see "Gemini hit MAX_TOKENS" errors.
LLM_MAX_OUTPUT_TOKENS=0
